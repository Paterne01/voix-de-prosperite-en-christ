# ─────────────────────────────────────────────────────────────
# Voix de Prospérité en Christ — secrets d'exemple
# ─────────────────────────────────────────────────────────────
# 1. Copier ce fichier en `.env` à la racine du projet.
# 2. Remplir les valeurs (sans guillemets).
# 3. Ordre de lecture : trousseau natif (keyring) → .env → erreur claire.
#    Un secret présent dans le trousseau Windows/macOS/Linux est prioritaire.
# 4. Ne JAMAIS commiter le fichier .env (déjà exclu par .gitignore).

# Clé API Google Gemini — https://aistudio.google.com/apikey
# Génère les textes (légendes, déclarations, CTA) et les aperçus d'images.
GEMINI_API_KEY=

# Jeton d'accès Page Facebook (longue durée) — Dashboard Meta Developers.
# Permet de publier images, Reels et commentaires sur votre Page.
FACEBOOK_PAGE_TOKEN=

# Jeton Hugging Face — https://huggingface.co/settings/tokens
# Optionnel : génération d'images cloud (modèle FLUX) si image_mode=cloud.
HUGGINGFACE_TOKEN=

# TikTok — Client Key (client_key), issu de l'app TikTok créée sur
# https://developers.tiktok.com (Direct Post API). Optionnel.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# TikTok — jetons OAuth obtenus après autorisation. Optionnel.
# Générés automatiquement via l'interface ; vous n'avez normalement rien à remplir.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_EXPIRES_AT=
