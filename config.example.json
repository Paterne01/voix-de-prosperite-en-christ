{
  "_doc": "Ceci est le fichier d'exemple. Copiez-le en config.json puis remplissez vos valeurs. Les clés inconnues (ex. _doc) sont ignorées par le programme. Section ai : fournisseur principal (provider), ordre de bascule automatique (fallback_order) et détails par provider. Chaque provider utilise une clé de secret enregistrée (dashboard > Clés sécurisées, ou .env). Si le provider principal échoue (quota, panne), l'app essaie les suivants automatiquement puis Hugging Face puis le générateur local. Testez les clés avec : python run_job.py --check-ai.",
  "page_id": "",
  "timezone": "Africa/Nairobi",
  "schedule": ["00:00", "08:00", "12:00", "16:00"],
  "schedule_formats": {
    "00:00": "declaration",
    "08:00": "video",
    "12:00": "declaration",
    "16:00": "video"
  },
  "content_plan": {
    "mode": "day_based",
    "week": {
      "monday": "Dignité",
      "tuesday": "Sagesse",
      "wednesday": "Libération",
      "thursday": "Productivité",
      "friday": "Restauration relationnelle",
      "saturday": "Provision Active",
      "sunday": "Générosité"
    }
  },
  "logo_path": "assets/logo.png",
  "image_mode": "local",
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "fallback_order": [
      "gemini",
      "openrouter",
      "grok",
      "nvidia",
      "zen",
      "deepseek",
      "ollama",
      "openai"
    ],
    "providers": {
      "gemini": {
        "api_key_secret": "gemini_api_key",
        "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
        "model": "gemini-2.5-flash"
      },
      "openrouter": {
        "api_key_secret": "openrouter_api_key",
        "base_url": "https://openrouter.ai/api/v1",
        "model": "meta-llama/llama-3.3-70b-instruct:free"
      },
      "ollama": {
        "api_key_secret": null,
        "base_url": "http://localhost:11434/v1",
        "model": "llama3.1"
      },
      "grok": {
        "api_key_secret": "xai_api_key",
        "base_url": "https://api.x.ai/v1",
        "model": "grok-3-mini"
      },
      "nvidia": {
        "api_key_secret": "nvidia_api_key",
        "base_url": "https://integrate.api.nvidia.com/v1",
        "model": "meta-llama/Llama-3.3-70B-Instruct"
      },
      "zen": {
        "api_key_secret": "zai_api_key",
        "base_url": "https://api.z.ai/api/paas/v4",
        "model": "glm-4.5-flash"
      },
      "openai": {
        "api_key_secret": "openai_api_key",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o-mini"
      },
      "deepseek": {
        "api_key_secret": "deepseek_api_key",
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat"
      }
    }
  },
  "manual_schedule": {
    "mode": "slots",
    "slots": ["04:00", "20:00"],
    "interval_hours": 4,
    "start_hour": "00:00",
    "networks": ["facebook", "youtube", "tiktok"]
  },
  "cloud_image": {
    "provider": "huggingface",
    "model": "black-forest-labs/FLUX.1-schnell",
    "enabled": false
  },
  "publishers": {
    "facebook": true,
    "youtube": false,
    "tiktok": {
      "enabled": false,
      "audited": false
    }
  },
  "paths": {
    "images": "Images",
    "videos": "Videos",
    "texts": "Textes",
    "logs": "Logs",
    "database": "BaseDeDonnées/voix_prosperite.sqlite3",
    "manual_review": "manual_review",
    "pending": "assets/pending",
    "backgrounds": "assets/format_a/backgrounds",
    "formats": {
      "format_a": {
        "backgrounds": "assets/format_a/backgrounds",
        "audio": "assets/format_a/audio"
      },
      "format_b": {
        "backgrounds": "assets/format_b/backgrounds",
        "audio": "assets/format_b/audio"
      }
    }
  },
  "facebook": {
    "api_version": "v25.0",
    "max_retries": 3
  },
  "youtube": {
    "privacy_status": "public",
    "max_retries": 3
  },
  "tiktok": {
    "privacy_level": "SELF_ONLY",
    "is_aigc": true,
    "chunk_size": 8388608,
    "max_retries": 3,
    "poll_interval_s": 5,
    "poll_timeout_s": 900
  }
}
